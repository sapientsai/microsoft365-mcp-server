{
  "name": "@sapientsai/document-extract",
  "version": "0.0.0",
  "private": true,
  "description": "Binary document → text extraction (PDF/DOCX/XLSX/text). Takes a buffer and a content type, returns text or an ExtractError. Knows nothing about Microsoft Graph — and holds the workspace's only heavy parser dependencies, so the packages that import it eagerly stay cheap.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "validate": "ts-builds validate",
    "format": "ts-builds format",
    "format:check": "ts-builds format:check",
    "lint": "ts-builds lint",
    "lint:check": "ts-builds lint:check",
    "typecheck": "ts-builds typecheck",
    "test": "ts-builds test",
    "test:watch": "ts-builds test:watch",
    "test:coverage": "ts-builds test:coverage",
    "build": "ts-builds build",
    "dev": "ts-builds dev"
  },
  "prettier": "ts-builds/prettier",
  "dependencies": {
    "exceljs": "^4.4.0",
    "functype": "^1.9.0",
    "mammoth": "^1.12.2",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "ts-builds": "^3.4.1",
    "tsdown": "^0.22.14"
  },
  "engines": {
    "node": ">=22"
  }
}
