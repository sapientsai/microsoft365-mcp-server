{
  "name": "microsoft365-mcp-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for the Microsoft Graph MCP servers (microsoft365 + shared core).",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "validate": "pnpm -r validate",
    "ci": "pnpm -r run ci",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm -r lint:check",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "build:mcpb": "pnpm --filter microsoft365-mcp-server build:mcpb"
  },
  "devDependencies": {
    "ts-builds": "^4.7.0"
  }
}
